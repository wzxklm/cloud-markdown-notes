APP_ENV=production
API_PORT=3000
WEB_PORT=5173
PROD_HOST_API_PORT=8080
PROD_HOST_WEB_PORT=5173
# Use a public image digest or a locally built image tag from docs/self-hosting.md.
NOTES_IMAGE=

POSTGRES_USER=notes
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=notes
DATABASE_URL=postgres://notes:replace-me@db:5432/notes

WORKSPACE_ROOT=/data/workspaces
PROD_HOST_DATA_ROOT=./runtime/selfhost
PUBLIC_BASE_URL=https://notes.example.com
SITE_OPERATOR="Your organization"
SUPPORT_EMAIL=support@example.com
NOTES_API_URL=https://notes.example.com

SESSION_SECRET=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
# Copy this example to .env.prod for a new deployment. Use one Stripe account and mode throughout.
# Register https://<your-domain>/api/billing/webhook with the events listed in docs/self-hosting.md.
# For live payments set STRIPE_LIVEMODE=true and supply the live credentials and IDs.
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Card subscription: a recurring HKD 10/month price.
STRIPE_PRICE_ID=

# One-time wallet top-ups: set your active Stripe product ID (prod_...) to enable recharge.
# A successful payment credits the wallet. Customers can separately enable balance renewal.
STRIPE_TOPUP_PRODUCT_ID=
# Optional one-time HKD prices on that product for HK$10, HK$30 and HK$100.
# Blank prices use dynamic pricing on the product, also used for custom amounts (HK$10–1,000).
STRIPE_TOPUP_PRICE_10=
STRIPE_TOPUP_PRICE_30=
STRIPE_TOPUP_PRICE_100=
